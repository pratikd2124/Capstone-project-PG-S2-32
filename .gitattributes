# Customer data must stay byte-identical to Box (the baseline checks SHA-1).
# Never let git convert line endings in it (Windows core.autocrlf would otherwise change the files).
data/** -text
*.onnx binary
*.RData binary
*.csv -text
*.json -text

# Windows batch files need CRLF line endings to run reliably
*.bat text eol=crlf
*.sh text eol=lf
